# Copy this file to ".env" and fill in your real MySQL credentials.
# .env is gitignored so your password is never pushed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=washwise

# Secret used to sign login JWTs. Use a long random string in real deployments.
SECRET_KEY=change_this_to_a_random_secret

# Comma-separated list of frontend origins allowed to call this API.
# "*" (default) allows any origin, which is fine for local dev / a demo.
ALLOWED_ORIGINS=*

# --- Optional: enable real email notifications (SMTP) ---
# Leave blank to skip email and just log notifications instead.
# Example with a Gmail account: create an "app password" at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: enable real SMS notifications (Twilio) ---
# Leave blank to skip SMS and just log notifications instead.
# Create a free trial account at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
